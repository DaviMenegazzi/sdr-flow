PORT=3001
PUBLIC_API_URL=http://localhost:3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
# Credenciais OAuth2 do Google Calendar, somente no servidor (JSON em uma linha).
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# Mantenha false até homologar os provedores. Playground nunca envia ao WhatsApp.
WHATSAPP_SEND_ENABLED=false
META_GRAPH_VERSION=v21.0
# Segredo aleatório persistente para criptografar credenciais. Mesmo valor na API e worker.
ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only; required for publishing. Never prefix this key with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
REDIS_URL=redis://127.0.0.1:6379
# 'worker': apps/api only produces to the canonical sdr-turns queue, apps/worker consumes it
# (required in production). 'api': dev-only inline execution, no separate worker process, no
# debounce. Defaults to 'worker' when REDIS_URL is set, else 'api'. See apps/api/src/app.ts.
TURN_PROCESSING_MODE=worker
TURN_WORKER_CONCURRENCY=5
OUTBOX_DISPATCH_INTERVAL_MS=30000
EVOLUTION_API_KEY=
EVOLUTION_SERVER_URL=
EVOLUTION_DATABASE_URL=
STANDALONE_MODE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173
# URL pública do app web (retorno do checkout). Usa PUBLIC_API_URL quando vazio.
PUBLIC_APP_URL=
# Cobrança da assinatura (docs/BILLING.md). Vazio/none = checkout indisponível (503).
# Nenhum adapter implementado ainda; asaas/mercado_pago/stripe exigem o adapter correspondente.
BILLING_PROVIDER=
# Segredos do gateway: somente API/worker, nunca com prefixo VITE_.
BILLING_API_KEY=
BILLING_WEBHOOK_TOKEN=
BILLING_MAINTENANCE_INTERVAL_MS=60000
