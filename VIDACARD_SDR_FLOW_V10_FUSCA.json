      "label": "Aviso antes handoff",
      "position": { "x": 4480, "y": 350 },
      "config": {
        "text": "Vou te encaminhar para nossa equipe pra te ajudar melhor. Um momento!",
        "typing": true,
        "maxBubbles": 1,
        "maxCharactersPerBubble": 350
      }
    },
    {
      "id": "handoff",
      "type": "action.handoff",
      "label": "Transferir p/ humano",
      "position": { "x": 4760, "y": 450 },
      "config": {
        "reason": "{{next_action.reason}}"
      }
    },
    {
      "id": "end",
      "type": "output.end",
      "label": "Encerrar fluxo",
      "position": { "x": 4760, "y": 300 },
      "config": {}
    }
